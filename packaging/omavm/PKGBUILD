# Maintainer: Arthur Augusto <arthuramagalhaes1312@gmail.com>

pkgname=omavm
pkgver=0.3.0
pkgrel=1
pkgdesc="Create, run and manage Boxes and Machines on Omarchy"
arch=('x86_64')
url="https://github.com/KitsuneForgering/OmaVM"
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'glib2' 'libglvnd' 'glibc' 'zlib')
makedepends=('go')
optdepends=('distrobox: integrated Development Box environments'
            'podman: preferred Distrobox container engine'
            'docker: alternative Distrobox container engine and legacy Boxes'
            'qemu-desktop: Machine environments with a graphical display (QEMU/KVM)'
            'virtiofsd: share host folders with Machine guests')
install=omavm.install
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('c3f261b68abea7545a5b01870546fa6ff5e802fb47577befe3625b048d1a9df3')

build() {
  cd "OmaVM-$pkgver"
  go build -ldflags="-s -w" -buildvcs=false -trimpath -o bin/omavm ./cmd/omavm
  mkdir -p build/gui
  cd build/gui
  qmake6 ../../omavm-gui.pro
  make
  cp omavm-gui ../../bin/omavm-gui
}

package() {
  cd "OmaVM-$pkgver"

  install -Dm755 bin/omavm "$pkgdir/usr/bin/omavm"
  install -Dm755 bin/omavm-gui "$pkgdir/usr/bin/omavm-gui"
  install -Dm644 data/dev.omavm.app.desktop "$pkgdir/usr/share/applications/dev.omavm.app.desktop"
  install -Dm644 data/icons/dev.omavm.app.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/dev.omavm.app.svg"
  install -Dm644 -t "$pkgdir/usr/share/omavm/icons" data/icons/colors/*.svg
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"

  # Reference copy only, never auto-enabled: Omarchy's plugin trust model
  # requires a human to review third-party QML and run
  # `omarchy plugin enable` themselves before it runs unsandboxed inside
  # the already-live shell. See the post-install message and
  # contrib/dev.omavm.bar/README.md.
  install -dm755 "$pkgdir/usr/share/doc/$pkgname/quickshell-plugin"
  cp -r contrib/dev.omavm.bar/. "$pkgdir/usr/share/doc/$pkgname/quickshell-plugin/"

  # Reference copy only: placing a Machine viewer window on its own
  # workspace is an opt-in choice about the user's own Hyprland config,
  # never edited on their behalf. See README.md and the file itself.
  install -Dm644 contrib/hypr/omavm-viewer.lua \
    "$pkgdir/usr/share/doc/$pkgname/hypr/omavm-viewer.lua"
}
